# Environment variables for development

# ===========================
# Form Backend Configuration
# ===========================
# Choose one provider: appscript, smtp, or third-party

# Apps Script: Only VITE_FORM_SCRIPT_URL required
# VITE_FORM_BACKEND=appscript
# VITE_FORM_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Custom API (smtp): VITE_FORM_API_URL points at your own endpoint
# VITE_FORM_BACKEND=smtp
# VITE_FORM_API_URL=https://example.com/api/contact

# Third-party backend: like smtp, it posts JSON to VITE_FORM_API_URL
# VITE_FORM_BACKEND=third-party
# VITE_FORM_API_URL=https://formspree.io/f/YOUR_FORM_ID

# ===========================
# Aki Chatbot (public frontend values)
# ===========================
# Worker base URL for the chatbot API (set after `npm run aki:deploy`)
# VITE_AKI_API_URL=https://aki-api.YOUR_SUBDOMAIN.workers.dev
# Turnstile site key (public). Unset sends an empty token, which the real Worker rejects.
# VITE_AKI_TURNSTILE_SITEKEY=0x4AAAAAAA_YOUR_SITE_KEY
